[Unit]
Description=Boreas hardware service for ASUS laptops (replaces asusd + supergfxd)
# Start after the NVIDIA services, so they can be stopped reliably for Eco at boot
After=systemd-modules-load.service nvidia-persistenced.service nvidia-powerd.service
Before=display-manager.service
Conflicts=asusd.service supergfxd.service

[Service]
Type=notify
ExecStart=/usr/bin/boreasd
Restart=on-failure
# Up to 20 s waiting for asus-wmi, then the GPU mode: unloading the NVIDIA modules and the
# firmware's dgpu_disable write can take tens of seconds. A start cut off in between leaves
# the dGPU half switched.
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
