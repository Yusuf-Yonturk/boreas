[Unit]
Description=Boreas hardware service for ASUS laptops (replaces asusd + supergfxd)
# Start after the NVIDIA services, so they can be stopped reliably for Eco at boot
After=systemd-modules-load.service nvidia-persistenced.service nvidia-powerd.service
Before=display-manager.service
Conflicts=asusd.service supergfxd.service

[Service]
Type=notify
ExecStart=/usr/bin/boreasd
Restart=on-failure
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
