#!/usr/bin/python3 -I
"""In-app update, the root side: started by pkexec as
`python3 -I boreas-update [--proxy-stdin] <version>`.

It imports the installed copy next to it (root's files), downloads the release <version> into a
folder only root can reach and runs that release's install.sh. Every failure exits with 1 and its
reason as the last line on stderr; 126 and 127 are left to pkexec (cancelled, not authorized).
"""
import os
import sys

# pkexec passes the caller's umask on: what root writes here must not be open to other users
os.umask(0o022)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))


def main(argv: list[str]) -> int:
    args = argv[1:]
    proxy_stdin = len(args) == 2 and args[0] == "--proxy-stdin"
    if proxy_stdin:
        args = args[1:]
    if len(args) != 1:
        print("usage: boreas-update [--proxy-stdin] VERSION", file=sys.stderr)
        return 1
    try:
        from boreas import update
        update.tarball_url(args[0])  # a release version, nothing else
        # only forward: an older release (with fixed bugs back in) is not installed through here
        if not update.is_newer(args[0]):
            raise ValueError(f"{args[0]} is not newer than the installed {update.__version__}")
        if proxy_stdin:
            # on stdin, not argv: other users can read argv in /proc and pkexec logs it
            proxy = update.normalize_proxy(sys.stdin.readline(4096).removesuffix("\n"))
            os.environ["https_proxy"] = proxy  # urllib here and curl in install.sh read it
        if os.geteuid() != 0:
            raise PermissionError("boreas-update must run as root (pkexec)")
        update.install_release(args[0])
    except Exception as e:
        print(f"{e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
